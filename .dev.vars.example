# Copy to .dev.vars for local overrides. Never commit .dev.vars.
APP_MODE=fixture
FIXTURE_USER_EMAIL=director@backrooms.local

# Optional local real-data integration. Keep the actual values in .dev.vars only.
# GOOGLE_BRIDGE_URL=https://script.google.com/macros/s/your-deployment-id/exec
# GOOGLE_BRIDGE_REQUEST_SECRET=use-the-same-random-secret-as-the-apps-script-property

# Production-only examples (leave unset locally and store as Worker secrets):
# APP_ORIGIN=https://backrooms.your-account.workers.dev
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# SESSION_SECRET=generate-at-least-32-random-characters
